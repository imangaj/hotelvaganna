DATABASE_URL="postgresql://user:password@localhost:5432/pms_db"
JWT_SECRET="your_jwt_secret_key_here"
JWT_EXPIRE="7d"
PORT=5000
NODE_ENV=development

# Booking.com Channel Manager
BOOKING_COM_API_KEY="your_booking_com_api_key"
BOOKING_COM_API_URL="https://api.booking.com/v1"

# Email configuration (required for booking notifications and password recovery)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your_email@gmail.com"
SMTP_PASS="your_email_app_password"
SMTP_FROM="your_email@gmail.com"
HOTEL_EMAIL="hotel.valganna@libero.it"
BOOKING_NOTIFICATION_EMAIL="hotel.valganna@libero.it"
FRONTEND_URL="https://hotelvalganna.it"
# Optional separate guest session secret; otherwise JWT_SECRET is used.
GUEST_JWT_SECRET=""

# DigitalOcean blocks SMTP ports by default. Use a verified HTTPS mail provider.
MAIL_PROVIDER="resend"
RESEND_API_KEY=""
MAIL_FROM="Hotel Valganna <reservations@hotelvalganna.it>"
